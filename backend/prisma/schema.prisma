generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnonymousChatSession {
  id           String   @id
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("anonymous_chat_sessions")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  cashBalance  Float         @default(10000)
  tokenVersion Int           @default(0)
  createdAt    DateTime      @default(now())
  chatHistory  ChatMessage[]
  holdings     Holding[]
  transactions Transaction[]
  watchlist    Watchlist[]

  @@map("users")
}

// Row-per-job mutex so cron jobs run at most once across all backend
// instances — a job claims its row by extending lockedUntil, and any
// instance that loses the race skips that run. See src/utils/jobLock.js.
model JobLock {
  jobName     String   @id @map("job_name")
  lockedUntil DateTime @map("locked_until")

  @@map("job_locks")
}

model StockPrice {
  id         Int      @id @default(autoincrement())
  symbol     String   @unique
  close      Float
  high       Float
  low        Float
  open       Float
  dp         Float
  d          Float
  insertedAt DateTime @default(now())

  @@map("stocks_price")
}

model WeeklyChart {
  id            Int      @id @default(autoincrement())
  symbol        String
  date          String
  open          Float
  high          Float
  low           Float
  close         Float
  adjustedClose Float?
  volume        BigInt?
  insertedAt    DateTime @default(now())

  @@unique([symbol, date])
  @@map("weekly_chart")
}

model CryptoCurrencyRate {
  id            Int      @id @default(autoincrement())
  fromSymbol    String
  toSymbol      String
  exchangeRate  Float
  lastRefreshed String
  insertedAt    DateTime @default(now())

  @@unique([fromSymbol, toSymbol])
  @@map("crypto_currency_rate")
}

model CryptoChart {
  id         Int      @id @default(autoincrement())
  symbol     String
  date       String
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float?
  insertedAt DateTime @default(now())

  @@unique([symbol, date])
  @@map("crypto_chart")
}

model ForexPrice {
  id         Int      @id @default(autoincrement())
  fromSymbol String
  toSymbol   String
  date       String
  open       Float
  high       Float
  low        Float
  close      Float
  insertedAt DateTime @default(now())

  @@unique([fromSymbol, toSymbol, date])
  @@map("forex_price")
}

model CompanyProfile {
  id                   Int      @id @default(autoincrement())
  ticker               String   @unique
  name                 String?
  exchange             String?
  finnhubIndustry      String?
  marketCapitalization Float?
  logo                 String?
  weburl               String?
  updatedAt            DateTime @default(now())

  @@map("company_profile")
}

model MarketNews {
  id         Int      @id @default(autoincrement())
  newsId     Int      @unique
  category   String?
  datetime   Int?
  headline   String?
  source     String?
  url        String?
  insertedAt DateTime @default(now())

  @@map("market_news")
}

model CompanyNews {
  id         Int      @id @default(autoincrement())
  newsId     Int
  symbol     String
  category   String?
  datetime   Int?
  headline   String?
  image      String?
  source     String?
  summary    String?
  url        String?
  insertedAt DateTime @default(now())

  @@unique([newsId, symbol])
  @@map("company_news")
}

model IpoCalendar {
  id         Int      @id @default(autoincrement())
  symbol     String?
  name       String?
  date       String?
  price      Float?
  shares     Float?
  status     String?
  insertedAt DateTime @default(now())

  @@map("ipo_calendar")
}

model Insight {
  id          Int      @id @default(autoincrement())
  type        String   @unique
  content     String
  generatedAt DateTime @default(now())

  @@map("insights")
}

model Watchlist {
  id      Int      @id @default(autoincrement())
  userId  Int
  symbol  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])

  @@unique([userId, symbol])
  @@map("watchlist")
}

enum AssetType {
  STOCK
  CRYPTO
  FOREX
}

// Open position for a user, average-cost basis. Quantity/avgCost are updated
// in place as BUY/SELL trades execute — this table has no history, only the
// current net position (history lives in Transaction).
model Holding {
  id        Int       @id @default(autoincrement())
  userId    Int
  assetType AssetType
  symbol    String
  quantity  Float
  avgCost   Float
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, assetType, symbol])
  @@map("holdings")
}

enum TradeSide {
  BUY
  SELL
}

// Immutable audit log of every simulated trade — a Holding is derived state,
// this is the source of truth for what actually happened and when.
model Transaction {
  id        Int       @id @default(autoincrement())
  userId    Int
  assetType AssetType
  symbol    String
  side      TradeSide
  quantity  Float
  price     Float
  total     Float
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("transactions")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("chat_messages")
}

model NewsSentiment {
  id                    Int      @id @default(autoincrement())
  symbol                String
  title                 String?
  url                   String
  bannerImage           String?
  source                String?
  sourceDomain          String?
  summary               String?
  overallSentimentLabel String?
  overallSentimentScore Float?
  sentimentLabel        String?
  sentimentScore        Float?
  relevanceScore        Float?
  publishedAt           String?
  fetchedAt             DateTime @default(now())

  @@unique([url, symbol])
  @@map("news_sentiment")
}
